[Unit]
Description=FrameFable story panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=framefable
Group=framefable
WorkingDirectory=/opt/framefable
EnvironmentFile=/etc/framefable.env
Environment=PYTHONUNBUFFERED=1
Environment=HF_HOME=/var/cache/framefable/huggingface
CacheDirectory=framefable
ExecStart=/opt/framefable/run.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
